# Copy this file to `.env` in the project root and fill in what you need.
# The .env file is gitignored and never leaves your machine.
#
# Alpaca keys are best entered in the app: Settings -> Money & keys (stored
# encrypted). Without keys the bot uses practice money and free public prices.

# --- Telegram (recommended) ---
# 1. Open Telegram, message @BotFather, send /newbot, follow the prompts.
# 2. Paste the token it gives you here.
TELEGRAM_BOT_TOKEN=
# 3. Message @userinfobot to get your numeric chat id, paste it here.
#    Only these ids can talk to your bot. Comma-separate for several people.
TELEGRAM_CHAT_IDS=

# --- Alpaca (only for paper/live execution modes) ---
# Free account at https://alpaca.markets — accepts Turkish residents.
# Keep ALPACA_PAPER=true until you have watched the strategy work.
ALPACA_API_KEY=
ALPACA_API_SECRET=
ALPACA_PAPER=true

# --- The AI in the side panel (all optional) ---
# Without any of these the panel still narrates, it just writes from templates.
# With one, it answers you properly and remembers what you tell it.
# You only need ONE. Cheapest first:
#
#   1. Ollama - free, runs on your own machine, no account and no key at all.
#      Install from https://ollama.com then run:  ollama pull llama3.2
#      Nothing to paste here; the app finds it by itself.
#
#   2. Gemini - free tier, no card. Key: https://aistudio.google.com/apikey
GEMINI_API_KEY=

#   3. Groq - free tier, no card, very fast. Key: https://console.groq.com/keys
GROQ_API_KEY=

#   4. Claude - paid, and the strongest of the four. https://console.anthropic.com
ANTHROPIC_API_KEY=

# --- Dashboard access token ---
# Any random string. Required to open the dashboard from your phone.
DASHBOARD_TOKEN=
